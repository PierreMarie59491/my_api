{% extends 'base.html.twig' %}

{% block title %}Users index{% endblock %}

{% block body %}
    <h1>Liste des utilisateurs</h1>

    <table class="table">
        <thead>
            <tr>
                <!-- <th>Id</th> -->
                <th>Prenom</th>
                <th>Nom</th>
                <th>Pseudo</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <!-- <td>{{ user.id }}</td> -->
                <td>{{ user.Prenom }}</td>
                <td>{{ user.Nom }}</td>
                <td>{{ user.Pseudo }}</td>
                <td>
                    <a href="{{ path('app_users_show', {'id': user.id}) }}">Voir</a>
                    <a href="{{ path('app_users_edit', {'id': user.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucun utilisateur trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_users_new') }}">Ajouter un utilisateur</a>
{% endblock %}
